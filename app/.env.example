DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CRON_SECRET=
# First-admin bootstrap. Registration is closed unless BOTH are set and no workspace exists yet.
OWNER_EMAIL=
SETUP_TOKEN=
# Optional external reminder channel (your own WhatsApp/email/push bridge)
WEBHOOK_URL=
WEBHOOK_SECRET=
# Later phases
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Google Sheets two-way sync (service account). Never commit the real values or the key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Shared secret the sheet's Apps Script sends to /api/sheet/webhook
SHEET_WEBHOOK_SECRET=
